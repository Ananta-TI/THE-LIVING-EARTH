# Public Site Configuration
# Copy this file to .env.local if you want to override the defaults.
# All content lives in src/data/*.json and is read at build time.

# Canonical site URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://thelivingearth.org

# Optional override for the editorial contact address.
NEXT_PUBLIC_CONTACT_EMAIL=editorial@thelivingearth.org
